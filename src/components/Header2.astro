<script>
  // Adds "header-scrolled" after scrolling down and removes it near the top.
  // Two thresholds (60 and 20) stop the header flickering as it resizes.
  const header = document.querySelector<HTMLElement>(".tz-header1");

  if (header) {
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const isScrolled = header.classList.contains("header-scrolled");

      if (!isScrolled && y > 60) header.classList.add("header-scrolled");
      else if (isScrolled && y < 20) header.classList.remove("header-scrolled");

      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );

    update(); // handles a reload that happens partway down the page
  }
</script>

<style>
