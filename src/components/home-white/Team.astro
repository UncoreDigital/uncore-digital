    background: #fff;
    color: #4a5565;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .team-card__social i {
    font-size: 16px;
  }

  .team-card__social:hover {
    background: #caf310;
    border-color: #caf310;
    color: #000;
  }

