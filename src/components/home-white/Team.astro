<style>
  /* Flexible team grid: any number of cards, last row stays centered */
  .team-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
  }

  .team-grid__item {
    flex: 0 1 320px; /* card width: raise or lower this to resize */
    max-width: 100%;
  }

  /* Card */
  .team-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e4e8ee;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(16, 24, 40, 0.06);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .team-card:hover {
    transform: translateY(-6px);
    border-color: #caf310;
    box-shadow: 0 14px 30px rgba(16, 24, 40, 0.14);
  }

  /* Photo */
  .team-card__photo {
    aspect-ratio: 4 / 4.4;
    overflow: hidden;
    background: #f3f5f7;
  }

  .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.5s ease;
  }

  .team-card:hover .team-card__photo img {
    transform: scale(1.04);
  }

  /* Text area */
  .team-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 20px 22px 22px;
    background: #fff;
  }

  .team-card__name {
    margin: 0 0 4px;
    font-size: 20px;
    line-height: 1.25;
    color: #101828;
  }

  .team-card__role {
    margin: 0 0 12px;
    font-size: 14px;
    color: #5f7a00; /* darker green so it reads on white; #caf310 is too light */
  }

  .team-card__desc {
    margin: 0 0 18px;
    font-size: 14px;
    line-height: 1.6;
    color: #4a5565;
  }

  /* LinkedIn pill button, pinned to the bottom so buttons line up across cards */
  .team-card__social {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid #dfe3e8;
