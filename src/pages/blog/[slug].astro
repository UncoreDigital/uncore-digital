---
// src/pages/blog/[slug].astro
import { supabase } from '../../lib/supabase.js';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const { data: blogs, error } = await supabase
    .from('Blogs')
    .select('slug')
    .eq('status', 'Published');

  if (error || !blogs) return [];

  return blogs.map((blog) => ({
    params: { slug: blog.slug },
  }));
}

const { slug } = Astro.params;

// Fetch current blog
const { data: blog } = await supabase
  .from('Blogs')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'Published')
  .single();

if (!blog) {
  return Astro.redirect('/404');
}

// Format tags into an array (handles commas and prevents double ##)
const tagsList = blog.tags 
  ? blog.tags.split(',').map((tag) => tag.trim().replace(/^#/, '')).filter(Boolean) 
  : [];

// Fetch related blogs for "Keep reading"
const { data: relatedBlogs } = await supabase
  .from('Blogs')
  .select('title, slug, category, excerpt')
  .eq('status', 'Published')
  .neq('id', blog.id)
  .order('created_at', { ascending: false })
  .limit(2);
---

<Layout title={`${blog.title} - Uncore Digital`}>
  <section class="post">
    <div class="container post__container">
      <a href="/blogs" class="post__back montserrat-regular">
        <i class="ph ph-arrow-left"></i> Back to articles
      </a>

      <header class="post__header text-center">
        <span class="post__badge">{blog.category}</span>
        <h1 class="post__title">{blog.title}</h1>
        {blog.excerpt && <p class="post__excerpt">{blog.excerpt}</p>}
        <div class="post__author">
          <strong>{blog.author}</strong>
          {blog.author_role && <span> • {blog.author_role}</span>}
        </div>
      </header>

      {blog.cover_image_url && (
        <img class="post__cover" src={blog.cover_image_url} alt={blog.title} />
      )}

      <!-- Body Content -->
      <div class="post__body" set:html={blog.body}></div>

      <!-- Tags & Share Section -->
      <div class="post__footer">
        <hr class="post__divider" />
        
        {tagsList.length > 0 && (
          <div class="post__tags">
            {tagsList.map((tag) => (
              <span class="tag-pill">#{tag}</span>
            ))}
          </div>
        )}

        <div class="post__share">
  <span class="share-text">Found this useful? Share it with your network.</span>
  <div class="d-flex gap-2">
    <!-- LinkedIn Share Button -->
    <a 
      href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url}`} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="share-btn"
    >
      <i class="ph ph-linkedin-logo"></i> Share on LinkedIn
    </a>
    
    <!-- Existing Copy Link Button -->
    <button class="share-btn" id="copy-link-btn" type="button">
      <i class="ph ph-link"></i> Copy Link
    </button>
  </div>
</div>
      </div>
    </div>
  </section>

  <!-- Keep Reading Section -->
  {relatedBlogs && relatedBlogs.length > 0 && (
    <section class="keep-reading">
      <div class="container keep-reading__container">
        <h2 class="keep-reading__heading">Keep reading</h2>
        
        <div class="keep-reading__grid">
          {relatedBlogs.map((related) => (
            <a href={`/blog/${related.slug}`} class="related-card">
              <span class="related-card__category">{related.category}</span>
              <h3 class="related-card__title">{related.title}</h3>
              <p class="related-card__excerpt">{related.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<script>
  // Simple copy to clipboard functionality for the share button
  const copyBtn = document.getElementById('copy-link-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        const originalText = copyBtn.innerHTML;
        copyBtn.innerHTML = '<i class="ph ph-check"></i> Copied!';
        copyBtn.style.borderColor = '#ccff00';
        copyBtn.style.color = '#ccff00';
        
        setTimeout(() => {
          copyBtn.innerHTML = originalText;
          copyBtn.style.borderColor = '';
          copyBtn.style.color = '';
        }, 2000);
      });
    });
  }
</script>

<style>
  /* Base Post Styles */
  .post {
    background: #111;
    padding: 160px 0 60px; 
  }

  .post__container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .post__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ccff00 !important;
    text-decoration: none !important;
    font-size: 16px;
    margin-bottom: 32px;
  }
  .post__back:hover {
    text-decoration: underline !important;
  }

  .post__header { margin-bottom: 40px; }

  .post__badge {
    display: inline-block;
    background: #ccff00;
    color: #111;
    font-family: "Outfit", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 18px;
  }

  /* Updated Main Blog Title to Outfit */
  .post__title {
    font-family: "Outfit", sans-serif;
    font-weight: 700;
    font-size: clamp(36px, 5vw, 56px); /* Scaled down slightly since Outfit is wider */
    line-height: 1.2;
    color: #fff;
    margin: 0 0 16px;
  }

  .post__excerpt {
    font-family: "Outfit", sans-serif;
    font-size: 19px;
    line-height: 1.6;
    color: #b5b5b5;
    margin: 0 0 20px;
  }

  .post__author {
    font-family: "Outfit", sans-serif;
    font-size: 15px;
    color: #8a8a8a;
  }
  .post__author strong { color: #fff; font-weight: 500; }

  .post__cover {
    display: block;
    width: 100%;
    max-height: 460px;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 48px;
  }

  /* Body Content Styles */
  .post__body {
    font-family: "Outfit", sans-serif;
    font-size: 18px; 
    font-weight: 400;
    line-height: 1.65; 
    color: #d6d6d6;
    overflow-wrap: anywhere;
  }

  /* Neutralise fonts, sizes and colours carried over from other sites */
  .post__body :global(*) {
    font-family: "Outfit", sans-serif !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    line-height: inherit !important;
    color: inherit !important;
    letter-spacing: normal !important;
    text-transform: none !important;
    text-shadow: none !important;
    background: transparent !important;
  }

  .post__body :global(p) { margin: 0 0 16px; }

  .post__body :global(h1),
  .post__body :global(h2) {
    font-size: 26px !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
    color: #fff !important;
    margin: 32px 0 12px;
  }

  .post__body :global(h3),
  .post__body :global(h4),
  .post__body :global(h5),
  .post__body :global(h6) {
    font-size: 20px !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
    color: #fff !important;
    margin: 24px 0 10px;
  }

  .post__body :global(strong),
  .post__body :global(b) { font-weight: 600 !important; color: #fff !important; }

  .post__body :global(ul),
  .post__body :global(ol) { margin: 0 0 16px; padding-left: 24px; }
  .post__body :global(li) { margin-bottom: 4px; }

  .post__body :global(a) { color: #ccff00 !important; text-decoration: none; }
  .post__body :global(a:hover) { text-decoration: underline; }

  .post__body :global(blockquote) {
    border-left: 4px solid #ccff00;
    padding-left: 16px;
    margin: 24px 0;
    font-style: italic;
    color: #b5b5b5 !important;
  }

  .post__body :global(code),
  .post__body :global(pre) {
    font-family: ui-monospace, Consolas, monospace !important;
    font-size: 16px !important;
    background: #1b1b1b !important;
    border-radius: 6px;
  }
  .post__body :global(code) { padding: 2px 6px; }
  .post__body :global(pre) { padding: 16px; margin: 0 0 16px; overflow-x: auto; }

  .post__body :global(hr) { border: 0; border-top: 1px solid #333; margin: 24px 0; }
  .post__body :global(img) { max-width: 100%; height: auto; border-radius: 8px; margin: 16px 0; }

  /* Tags & Share Footer */
  .post__footer {
    margin-top: 60px;
  }

  .post__divider {
    border: none;
    border-top: 1px solid #333;
    margin-bottom: 32px;
  }

  .post__tags {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 12px !important;
    margin-bottom: 32px;
  }

  .tag-pill {
    display: inline-block;
    background: #1a1a1a !important;
    border: 1px solid #333 !important;
    color: #b5b5b5 !important;
    font-family: "Outfit", sans-serif;
    font-size: 14px;
    padding: 6px 16px;
    border-radius: 999px;
    transition: all 0.2s;
    line-height: 1;
  }
  .tag-pill:hover {
    border-color: #555 !important;
    color: #fff !important;
  }

  .post__share {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    font-family: "Outfit", sans-serif;
  }

  .share-text {
    font-size: 16px;
    color: #8a8a8a;
  }

  .share-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    background-color: transparent !important;
    border: 1px solid #444 !important;
    color: #fff !important;
    padding: 10px 20px !important;
    border-radius: 999px !important;
    font-size: 14px !important;
    font-family: "Outfit", sans-serif !important;
    font-weight: 500 !important;
    cursor: pointer !important;
    transition: all 0.2s !important;
    box-shadow: none !important;
  }
  .share-btn:hover {
    background-color: #222 !important;
    border-color: #ccff00 !important;
    color: #ccff00 !important;
  }

  /* Keep Reading Section */
  .keep-reading {
    background: #111;
    padding: 40px 0 100px;
  }

  .keep-reading__container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .keep-reading__heading {
    font-family: "Outfit", sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 32px;
  }

  .keep-reading__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .related-card {
    display: block;
    background: #1a1a1a !important;
    border: 1px solid #333 !important;
    border-radius: 12px;
    padding: 32px;
    text-decoration: none !important;
    transition: all 0.3s ease;
  }
  
  .related-card:hover {
    border-color: #ccff00 !important;
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  }

  .related-card__category {
    font-family: "Outfit", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ccff00 !important;
    display: block;
    margin-bottom: 16px;
  }

  .related-card__title {
    font-family: "Outfit", sans-serif;
    font-size: 22px;
    font-weight: 600;
    color: #fff !important; 
    line-height: 1.3;
    margin-bottom: 12px;
  }

  .related-card__excerpt {
    font-family: "Outfit", sans-serif;
    font-size: 15px;
    color: #b5b5b5 !important;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  @media (max-width: 768px) {
    .keep-reading__grid {
      grid-template-columns: 1fr;
    }
  }
</style>