---
// src/pages/blogs.astro
import { supabase } from '../lib/supabase.js';
import Layout from '../layouts/Layout.astro';

const { data: blogs } = await supabase
  .from('Blogs')
  .select('*')
  .eq('status', 'Published');
---

<Layout title="Our Blog - Uncore Digital">
  <section class="blog-list">
    <div class="container">
      <header class="blog-list__head text-center">
        <span class="blog-eyebrow montserrat-regular">Insights &amp; Updates</span>
        <h1 class="blog-list__title">Our Latest Articles</h1>
      </header>

      {blogs && blogs.length > 0 ? (
        <div class="row g-4">
          {blogs.map((blog) => (
            <div class="col-md-6 col-xl-4">
              <article class="blog-card">
                <a href={`/blog/${blog.slug}`} class="blog-card__media" tabindex="-1" aria-hidden="true">
                  <img src={blog.cover_image_url} alt={blog.title} loading="lazy" />
                </a>
                <div class="blog-card__body">
                  <span class="blog-badge">{blog.category}</span>
                  <h2 class="blog-card__title">
                    <a href={`/blog/${blog.slug}`}>{blog.title}</a>
                  </h2>
                  <p class="blog-card__excerpt">{blog.excerpt}</p>

                  <div class="d-flex justify-content-between align-items-center mt-4">
  
  <!-- Read More Button (Stays on the left) -->
  <a href={`/blog/${blog.slug}`} class="your-read-more-class">
    READ MORE <i class="ph ph-arrow-up-right"></i>
  </a>
  
  <!-- LinkedIn Share Button (Pushed completely to the right) -->
  <a 
    href={`https://www.linkedin.com/sharing/share-offsite/?url=https://www.uncoredigital.com/blog/${blog.slug}`} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="share-btn-small"
  >
    <i class="ph ph-linkedin-logo"></i> Share
  </a>
  
</div>
                </div>
              </article>
            </div>
          ))}
        </div>
      ) : (
        <p class="blog-empty text-center">New articles are on the way. Check back soon.</p>
      )}
    </div>
  </section>
</Layout>

<style>
  .blog-list {
    background: #111;
    padding: 160px 0 100px;
    min-height: 100vh;
  }

  .blog-list__head {
    margin-bottom: 56px;
  }

  .blog-eyebrow {
    display: inline-block;
    color: #ccff00;
    font-size: 14px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  /* Updated Main Page Title to Outfit */
  .blog-list__title {
    font-family: "Outfit", sans-serif;
    font-weight: 700;
    font-size: clamp(36px, 5vw, 56px); /* Scaled down for Outfit's wider proportions */
    line-height: 1.15;
    color: #fff;
    margin: 0;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .blog-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(204, 255, 0, 0.12);
  }

  .blog-card__media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #222;
  }
  .blog-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .blog-card:hover .blog-card__media img {
    transform: scale(1.05);
  }

  .blog-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px;
  }

  .blog-badge {
    align-self: flex-start;
    background: #111;
    color: #ccff00;
    font-family: "Outfit", sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  /* Card Title - Outfit */
  .blog-card__title {
    font-family: "Outfit", sans-serif;
    font-weight: 700;
    font-size: 24px; 
    line-height: 1.3;
    margin: 0 0 12px;
  }
  .blog-card__title a {
    color: #111;
    text-decoration: none;
  }
  .blog-card__title a:hover {
    color: #4a5d00;
  }

  .blog-card__excerpt {
    font-family: "Outfit", sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #555;
    margin: 0 0 24px;
    display: -webkit-box;
    -webkit-line-clamp: 3; 
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__cta {
    margin-top: auto;
  }

  .blog-empty {
    font-family: "Outfit", sans-serif;
    color: #aaa;
    font-size: 18px;
  }
  /* Share Button Styles for Blog Cards */
  .share-btn-small {
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    color: #666 !important; /* Neutral gray to replace the default blue */
    font-family: "Outfit", sans-serif;
    font-size: 14px !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    padding: 8px 14px !important;
    border-radius: 999px !important;
    background-color: transparent !important;
    border: 1px solid #ddd !important;
    transition: all 0.3s ease !important;
  }

  .share-btn-small i {
    font-size: 16px !important;
  }

  .share-btn-small:hover {
    color: #fff !important;
    background-color: #0077b5 !important; /* LinkedIn Blue on hover */
    border-color: #0077b5 !important;
  }
</style>