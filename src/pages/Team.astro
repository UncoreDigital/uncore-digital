---
import Layout from "../layouts/Layout.astro"; // must match your layout's real file name and folder
---

<Layout
  title="Our Team | Uncore Digital – Meet the Leadership"
  description="Meet the leadership team behind Uncore Digital: the people who guide our digital marketing, product development and digital transformation work."
>
  <!-- Canonical + social tags, placed in <head> through your existing custom-css slot -->
  <Fragment slot="custom-css">
    <link rel="canonical" href="https://uncoredigital.com/team" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Our Team | Uncore Digital" />
    <meta
      property="og:description"
      content="Meet the leadership team behind Uncore Digital."
    />
    <meta property="og:url" content="https://uncoredigital.com/team" />
  </Fragment>

  <!-- Team Hero Start -->
  <section class="team-hero">
    <div class="container">
      <span class="team-hero__eyebrow poppins-bold">Our Expert Team</span>
      <h1 class="team-hero__title poppins-bold">Meet the Leadership Team</h1>
      <p class="team-hero__text montserrat-regular">
        The people behind Uncore Digital, guiding every project with strategy,
        technology and care.
      </p>
    </div>
  </section>
  <!-- Team Hero End -->

  <!-- Team Start -->
  <section class="tz-team1 team-page bg-white">
    <div class="container">
      <!-- Cards: add or remove a "team-grid__item" block and the layout adjusts itself -->
      <div class="team-grid">
        <!-- Card 1 -->
        <div
          class="team-grid__item wow fadeInUp img-custom-anim-left"
          data-wow-delay=".3s"
        >
          <div class="team-card">
            <div class="team-card__photo">
              <img src="/assets/images/team/1.png" alt="Pratik Chaplot" />
            </div>
            <div class="team-card__body">
              <h2 class="team-card__name poppins-bold">Pratik Chaplot</h2>
              <p class="team-card__role montserrat-semibold">CEO</p>
              <p class="team-card__desc montserrat-regular">
                Sets the vision and strategy for Uncore Digital, guiding the
                team toward long-term growth and client success.
              </p>
              <a
                href="https://www.linkedin.com/in/pratik-chaplot/"
                target="_blank"
                rel="noopener noreferrer"
                class="team-card__social"
              >
                <svg
                  class="team-card__icon"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="5" cy="5.5" r="1" fill="currentColor"></circle>
                  <path d="M5 10v9"></path>
                  <path d="M10 19v-9"></path>
                  <path d="M10 14a4 4 0 0 1 8 0v5"></path>
                </svg>
                <span>LinkedIn</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div
          class="team-grid__item wow fadeInUp img-custom-anim-left"
          data-wow-delay=".4s"
        >
          <div class="team-card">
            <div class="team-card__photo">
              <img src="/assets/images/team/2.png" alt="Rishva Kharidia" />
            </div>
            <div class="team-card__body">
              <h2 class="team-card__name poppins-bold">Rishva Kharidia</h2>
              <p class="team-card__role montserrat-semibold">COO</p>
              <p class="team-card__desc montserrat-regular">
                Leads day-to-day operations and client experience, making sure
                every project is delivered smoothly and on time.
              </p>
              <a
                href="https://www.linkedin.com/in/rishvakharidia/"
                target="_blank"
                rel="noopener noreferrer"
                class="team-card__social"
              >
                <svg
                  class="team-card__icon"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="5" cy="5.5" r="1" fill="currentColor"></circle>
                  <path d="M5 10v9"></path>
                  <path d="M10 19v-9"></path>
                  <path d="M10 14a4 4 0 0 1 8 0v5"></path>
                </svg>
                <span>LinkedIn</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div
          class="team-grid__item wow fadeInUp img-custom-anim-left"
          data-wow-delay=".5s"
        >
          <div class="team-card">
            <div class="team-card__photo">
              <img src="/assets/images/team/3.png" alt="Gabriel Ilyayeff" />
            </div>
            <div class="team-card__body">
              <h2 class="team-card__name poppins-bold">Gabriel Ilyayeff</h2>
              <p class="team-card__role montserrat-semibold">
                Strategic Partner - USA
              </p>
              <p class="team-card__desc montserrat-regular">
                Supports partnerships and business growth across the USA,
                helping clients connect with the right digital solutions.
              </p>
              <a
                href="https://www.linkedin.com/in/gilyayeff/"
                target="_blank"
                rel="noopener noreferrer"
                class="team-card__social"
              >
                <svg
                  class="team-card__icon"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="5" cy="5.5" r="1" fill="currentColor"></circle>
                  <path d="M5 10v9"></path>
                  <path d="M10 19v-9"></path>
                  <path d="M10 14a4 4 0 0 1 8 0v5"></path>
                </svg>
                <span>LinkedIn</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="team-cta">
        <h2 class="team-cta__title poppins-bold">Work with our team</h2>
        <p class="team-cta__text montserrat-regular">
          Tell us about your project and get a free consultation. We reply to
          every enquiry.
        </p>
        <div class="tz-buttons d-flex justify-content-center">
          <a
            class="tz-button text-uppercase fw-medium tz-text-m montserrat-regular"
            href="/contact-us"
          >
            Contact Us</a
          >
          <a class="tz-button-circle" href="/contact-us"
            ><i class="ph ph-arrow-up-right"></i></a
          >
        </div>
      </div>
    </div>
  </section>
  <!-- Team End -->
</Layout>

<style>
  /* Hero */
  .team-hero {
    background: #121212;
    padding: 190px 0 70px; /* top padding clears the fixed header */
    text-align: center;
  }

  .team-hero__eyebrow {
    display: inline-block;
    color: #caf310;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 14px;
    margin-bottom: 14px;
  }

  .team-hero__title {
    color: #fff;
    font-size: clamp(34px, 5.5vw, 60px);
    line-height: 1.1;
    margin: 0 0 16px;
  }

  .team-hero__text {
    color: #b5b5b5;
    font-size: 17px;
    max-width: 620px;
    margin: 0 auto;
  }

  /* Section */
  .team-page {
    padding: 70px 0 100px;
  }

  /* Flexible team grid: any number of cards, last row stays centered */
  .team-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
  }

  .team-grid__item {
    flex: 0 1 320px; /* card width: raise or lower this to resize */
    max-width: 100%;
  }

  /* Card */
  .team-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e4e8ee;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(16, 24, 40, 0.06);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .team-card:hover {
    transform: translateY(-6px);
    border-color: #caf310;
    box-shadow: 0 14px 30px rgba(16, 24, 40, 0.14);
  }

  /* Photo */
  .team-card__photo {
    aspect-ratio: 4 / 4.4;
    overflow: hidden;
    background: #f3f5f7;
  }

  .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.5s ease;
  }

  .team-card:hover .team-card__photo img {
    transform: scale(1.04);
  }

  /* Text area */
  .team-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 20px 22px 22px;
    background: #fff;
  }

  .team-card__name {
    margin: 0 0 4px;
    font-size: 20px;
    line-height: 1.25;
    color: #101828;
  }

  .team-card__role {
    margin: 0 0 12px;
    font-size: 14px;
    color: #5f7a00; /* darker green so it reads on white; #caf310 is too light */
  }

  .team-card__desc {
    margin: 0 0 18px;
    font-size: 14px;
    line-height: 1.6;
    color: #4a5565;
  }

  /* LinkedIn pill button, pinned to the bottom so buttons line up across cards */
  .team-card__social {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid #dfe3e8;
    border-radius: 10px;
    background: #fff;
    color: #4a5565;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .team-card__icon {
    flex-shrink: 0;
  }

  .team-card__social:hover {
    background: #caf310;
    border-color: #caf310;
    color: #000;
  }

  /* CTA */
  .team-cta {
    max-width: 860px;
    margin: 70px auto 0;
    padding: 44px 28px;
    text-align: center;
    background: #121212;
    border-radius: 16px;
  }

  .team-cta__title {
    color: #fff;
    font-size: 28px;
    margin: 0 0 10px;
  }

  .team-cta__text {
    color: #b5b5b5;
    max-width: 460px;
    margin: 0 auto 24px;
  }

  @media (max-width: 767px) {
    .team-hero {
      padding: 150px 0 50px;
    }

    .team-page {
      padding: 50px 0 70px;
    }

    .team-grid__item {
      flex: 0 1 100%;
      max-width: 340px;
    }
  }
</style>