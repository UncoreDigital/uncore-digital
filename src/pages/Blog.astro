---
import Layout from "../layouts/Layout.astro"; // must match your layout's real file name and folder

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Uncore Digital Blog",
  url: "https://uncoredigital.com/blog",
  description:
    "Insights on digital marketing, product development and digital transformation from the Uncore Digital team.",
  publisher: {
    "@type": "Organization",
    name: "Uncore Digital",
    url: "https://uncoredigital.com",
  },
};
---

<Layout
  title="Blog | Uncore Digital – Digital Marketing, Product & Transformation Insights"
  description="Read insights, guides and ideas from the Uncore Digital team on digital marketing, product development and digital transformation."
>
  <!-- Canonical + social tags, placed in <head> through your existing custom-css slot -->
  <Fragment slot="custom-css">
    <link rel="canonical" href="https://uncoredigital.com/blog" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Blog | Uncore Digital" />
    <meta
      property="og:description"
      content="Insights, guides and ideas from the Uncore Digital team."
    />
    <meta property="og:url" content="https://uncoredigital.com/blog" />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <!-- Blog Hero Start -->
  <section class="bl-hero">
    <div class="container">
      <span class="bl-hero__eyebrow poppins-bold">Our Blog</span>
      <h1 class="bl-hero__title poppins-bold">Insights &amp; Ideas</h1>
      <p class="bl-hero__text montserrat-regular">
        Practical thinking on digital marketing, product development and digital
        transformation from the Uncore Digital team.
      </p>
    </div>
  </section>
  <!-- Blog Hero End -->

  <!-- Blog Start -->
  <section class="bl-body">
    <div class="container">
      <!-- Featured post -->
      <article class="bl-featured">
        <a href="#" class="bl-featured__image" aria-label="Read the featured article">
          <img
            src="/assets/images/blog/blog1-img2.jpg"
            alt="Featured article preview"
            loading="lazy"
            onerror="this.style.display='none'"
          />
          <span class="bl-badge montserrat-semibold">Featured</span>
        </a>
        <div class="bl-featured__body">
          <div class="bl-meta montserrat-regular">
            <span>Digital Marketing</span>
            <span aria-hidden="true">•</span>
            <time datetime="2026-10-29">Oct 29, 2026</time>
            <span aria-hidden="true">•</span>
            <span>6 min read</span>
          </div>
          <h2 class="bl-featured__title poppins-bold">
            <a href="#">Featured Article Title Goes Here</a>
          </h2>
          <p class="bl-featured__desc montserrat-regular">
            A short summary of your most important article. Two or three
            sentences that tell the reader what they will learn and why it
            matters to their business.
          </p>
          <a href="#" class="bl-link montserrat-semibold">
            Read article <i class="ph ph-arrow-up-right"></i>
          </a>
        </div>
      </article>

      <!-- Filter buttons -->
      <div class="bl-filters" role="group" aria-label="Filter articles">
        <button type="button" class="bl-filter is-active montserrat-semibold" data-filter="all">All</button>
        <button type="button" class="bl-filter montserrat-semibold" data-filter="marketing">Digital Marketing</button>
        <button type="button" class="bl-filter montserrat-semibold" data-filter="product">Product Development</button>
        <button type="button" class="bl-filter montserrat-semibold" data-filter="transformation">Digital Transformation</button>
      </div>

      <!-- Posts: copy or delete a "bl-item" block. data-category must be marketing, product or transformation -->
      <div class="bl-grid">
        <!-- Post 1 -->
        <article class="bl-item" data-category="marketing">
          <div class="bl-card">
            <a href="#" class="bl-card__image" aria-label="Read: Article Title One">
              <img src="/assets/images/blog/blog1-img1.jpg" alt="Article Title One preview" loading="lazy" onerror="this.style.display='none'" />
              <span class="bl-badge montserrat-semibold">Digital Marketing</span>
            </a>
            <div class="bl-card__body">
              <div class="bl-meta montserrat-regular">
                <time datetime="2026-10-22">Oct 22, 2026</time>
                <span aria-hidden="true">•</span>
                <span>5 min read</span>
              </div>
              <h2 class="bl-card__title poppins-bold"><a href="#">Article Title One</a></h2>
              <p class="bl-card__desc montserrat-regular">
                A short summary of the article in one or two sentences, telling
                the reader what they will take away.
              </p>
              <a href="#" class="bl-link montserrat-semibold">Read article <i class="ph ph-arrow-up-right"></i></a>
            </div>
          </div>
        </article>

        <!-- Post 2 -->
        <article class="bl-item" data-category="product">
          <div class="bl-card">
            <a href="#" class="bl-card__image" aria-label="Read: Article Title Two">
              <img src="/assets/images/blog/blog1-img1.jpg" alt="Article Title Two preview" loading="lazy" onerror="this.style.display='none'" />
              <span class="bl-badge montserrat-semibold">Product Development</span>
            </a>
            <div class="bl-card__body">
              <div class="bl-meta montserrat-regular">
                <time datetime="2026-10-15">Oct 15, 2026</time>
                <span aria-hidden="true">•</span>
                <span>7 min read</span>
              </div>
              <h2 class="bl-card__title poppins-bold"><a href="#">Article Title Two</a></h2>
              <p class="bl-card__desc montserrat-regular">
                A short summary of the article in one or two sentences, telling
                the reader what they will take away.
              </p>
              <a href="#" class="bl-link montserrat-semibold">Read article <i class="ph ph-arrow-up-right"></i></a>
            </div>
          </div>
        </article>

        <!-- Post 3 -->
        <article class="bl-item" data-category="transformation">
          <div class="bl-card">
            <a href="#" class="bl-card__image" aria-label="Read: Article Title Three">
              <img src="/assets/images/blog/blog1-img3.jpg" alt="Article Title Three preview" loading="lazy" onerror="this.style.display='none'" />
              <span class="bl-badge montserrat-semibold">Digital Transformation</span>
            </a>
            <div class="bl-card__body">
              <div class="bl-meta montserrat-regular">
                <time datetime="2026-10-08">Oct 8, 2026</time>
                <span aria-hidden="true">•</span>
                <span>4 min read</span>
              </div>
              <h2 class="bl-card__title poppins-bold"><a href="#">Article Title Three</a></h2>
              <p class="bl-card__desc montserrat-regular">
                A short summary of the article in one or two sentences, telling
                the reader what they will take away.
              </p>
              <a href="#" class="bl-link montserrat-semibold">Read article <i class="ph ph-arrow-up-right"></i></a>
            </div>
          </div>
        </article>

        <!-- Post 4 -->
        <article class="bl-item" data-category="marketing">
          <div class="bl-card">
            <a href="#" class="bl-card__image" aria-label="Read: Article Title Four">
              <img src="/assets/images/blog/blog1-img1.jpg" alt="Article Title Four preview" loading="lazy" onerror="this.style.display='none'" />
              <span class="bl-badge montserrat-semibold">Digital Marketing</span>
            </a>
            <div class="bl-card__body">
              <div class="bl-meta montserrat-regular">
                <time datetime="2026-10-01">Oct 1, 2026</time>
                <span aria-hidden="true">•</span>
                <span>6 min read</span>
              </div>
              <h2 class="bl-card__title poppins-bold"><a href="#">Article Title Four</a></h2>
              <p class="bl-card__desc montserrat-regular">
                A short summary of the article in one or two sentences, telling
                the reader what they will take away.
              </p>
              <a href="#" class="bl-link montserrat-semibold">Read article <i class="ph ph-arrow-up-right"></i></a>
            </div>
          </div>
        </article>

        <!-- Post 5 -->
        <article class="bl-item" data-category="product">
          <div class="bl-card">
            <a href="#" class="bl-card__image" aria-label="Read: Article Title Five">
              <img src="/assets/images/blog/blog1-img3.jpg" alt="Article Title Five preview" loading="lazy" onerror="this.style.display='none'" />
              <span class="bl-badge montserrat-semibold">Product Development</span>
            </a>
            <div class="bl-card__body">
              <div class="bl-meta montserrat-regular">
                <time datetime="2026-09-24">Sep 24, 2026</time>
                <span aria-hidden="true">•</span>
                <span>8 min read</span>
              </div>
              <h2 class="bl-card__title poppins-bold"><a href="#">Article Title Five</a></h2>
              <p class="bl-card__desc montserrat-regular">
                A short summary of the article in one or two sentences, telling
                the reader what they will take away.
              </p>
              <a href="#" class="bl-link montserrat-semibold">Read article <i class="ph ph-arrow-up-right"></i></a>
            </div>
          </div>
        </article>

        <!-- Post 6 -->
        <article class="bl-item" data-category="transformation">
          <div class="bl-card">
            <a href="#" class="bl-card__image" aria-label="Read: Article Title Six">
              <img src="/assets/images/blog/blog1-img3.jpg" alt="Article Title Six preview" loading="lazy" onerror="this.style.display='none'" />
              <span class="bl-badge montserrat-semibold">Digital Transformation</span>
            </a>
            <div class="bl-card__body">
              <div class="bl-meta montserrat-regular">
                <time datetime="2026-09-17">Sep 17, 2026</time>
                <span aria-hidden="true">•</span>
                <span>5 min read</span>
              </div>
              <h2 class="bl-card__title poppins-bold"><a href="#">Article Title Six</a></h2>
              <p class="bl-card__desc montserrat-regular">
                A short summary of the article in one or two sentences, telling
                the reader what they will take away.
              </p>
              <a href="#" class="bl-link montserrat-semibold">Read article <i class="ph ph-arrow-up-right"></i></a>
            </div>
          </div>
        </article>
      </div>

      <p class="bl-empty montserrat-regular" hidden>
        No articles in this category yet.
      </p>

      <!-- CTA -->
      <div class="bl-cta">
        <h2 class="bl-cta__title poppins-bold">Want results like these for your business?</h2>
        <p class="bl-cta__text montserrat-regular">
          Tell us about your goals and get a free consultation. We reply to
          every enquiry.
        </p>
        <div class="tz-buttons d-flex justify-content-center">
          <a
            class="tz-button text-uppercase fw-medium tz-text-m montserrat-regular"
            href="/contact-us"
          >
            Contact Us</a
          >
          <a class="tz-button-circle" href="/contact-us"
            ><i class="ph ph-arrow-up-right"></i></a
          >
        </div>
      </div>
    </div>
  </section>
  <!-- Blog End -->
</Layout>

<script>
  // Category filter
  const buttons = document.querySelectorAll<HTMLButtonElement>(".bl-filter");
  const items = document.querySelectorAll<HTMLElement>(".bl-item");
  const emptyMsg = document.querySelector<HTMLElement>(".bl-empty");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;

      buttons.forEach((b) => b.classList.remove("is-active"));
      button.classList.add("is-active");

      let visible = 0;
      items.forEach((item) => {
        const show = filter === "all" || item.dataset.category === filter;
        item.hidden = !show;
        if (show) visible++;
      });

      if (emptyMsg) emptyMsg.hidden = visible !== 0;
    });
  });
</script>

<style>
  /* Hero */
  .bl-hero {
    background: #121212;
    padding: 190px 0 70px; /* top padding clears the fixed header */
    text-align: center;
  }

  .bl-hero__eyebrow {
    display: inline-block;
    color: #caf310;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 14px;
    margin-bottom: 14px;
  }

  .bl-hero__title {
    color: #fff;
    font-size: clamp(34px, 5.5vw, 60px);
    line-height: 1.1;
    margin: 0 0 16px;
  }

  .bl-hero__text {
    color: #b5b5b5;
    font-size: 17px;
    max-width: 640px;
    margin: 0 auto;
  }

  /* Body */
  .bl-body {
    background: #fff;
    padding: 60px 0 100px;
  }

  /* Shared bits */
  .bl-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 12px;
    background: #fff;
    border-radius: 999px;
    color: #101828;
    font-size: 12px;
    line-height: 1;
  }

  .bl-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    color: #667085;
    font-size: 13px;
  }

  .bl-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #000;
    font-size: 14px;
    text-decoration: underline;
    text-decoration-color: #caf310;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .bl-link:hover {
    background: #caf310;
    text-decoration: none;
  }

  /* Featured post */
  .bl-featured {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 0;
    margin-bottom: 56px;
    background: #fff;
    border: 1px solid #e4e8ee;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(16, 24, 40, 0.06);
    transition:
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .bl-featured:hover {
    border-color: #caf310;
    box-shadow: 0 14px 30px rgba(16, 24, 40, 0.12);
  }

  .bl-featured__image {
    position: relative;
    display: block;
    min-height: 340px;
    overflow: hidden;
    background: linear-gradient(135deg, #1b1b1b 0%, #3a4a0a 100%); /* shows until you add real images */
  }

  .bl-featured__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .bl-featured:hover .bl-featured__image img {
    transform: scale(1.04);
  }

  .bl-featured__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 40px;
  }

  .bl-featured__title {
    margin: 0 0 14px;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.2;
  }

  .bl-featured__title a {
    color: #101828;
  }

  .bl-featured__desc {
    margin: 0 0 22px;
    color: #4a5565;
    font-size: 16px;
    line-height: 1.75;
  }

  /* Filters */
  .bl-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 40px;
  }

  .bl-filter {
    padding: 10px 20px;
    border: 1px solid #dfe3e8;
    border-radius: 999px;
    background: #fff;
    color: #4a5565;
    font-size: 14px;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .bl-filter:hover,
  .bl-filter.is-active {
    background: #caf310;
    border-color: #caf310;
    color: #000;
  }

  /* Grid */
  .bl-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .bl-item[hidden] {
    display: none;
  }

  /* Card */
  .bl-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e4e8ee;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(16, 24, 40, 0.06);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .bl-card:hover {
    transform: translateY(-6px);
    border-color: #caf310;
    box-shadow: 0 14px 30px rgba(16, 24, 40, 0.14);
  }

  .bl-card__image {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: linear-gradient(135deg, #1b1b1b 0%, #3a4a0a 100%); /* shows until you add real images */
  }

  .bl-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .bl-card:hover .bl-card__image img {
    transform: scale(1.05);
  }

  .bl-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 22px;
  }

  .bl-card__title {
    margin: 0 0 8px;
    font-size: 20px;
    line-height: 1.3;
  }

  .bl-card__title a {
    color: #101828;
  }

  .bl-card__title a:hover {
    text-decoration: underline;
    text-decoration-color: #caf310;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .bl-card__desc {
    margin: 0 0 18px;
    font-size: 14px;
    line-height: 1.65;
    color: #4a5565;
  }

  .bl-card .bl-link {
    margin-top: auto;
  }

  .bl-empty {
    text-align: center;
    color: #4a5565;
    margin: 30px 0 0;
  }

  /* CTA */
  .bl-cta {
    max-width: 860px;
    margin: 70px auto 0;
    padding: 44px 28px;
    text-align: center;
    background: #121212;
    border-radius: 16px;
  }

  .bl-cta__title {
    color: #fff;
    font-size: 28px;
    margin: 0 0 10px;
  }

  .bl-cta__text {
    color: #b5b5b5;
    max-width: 460px;
    margin: 0 auto 24px;
  }

  /* Responsive */
  @media (max-width: 991px) {
    .bl-featured {
      grid-template-columns: 1fr;
    }

    .bl-featured__image {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }

    .bl-featured__body {
      padding: 28px;
    }

    .bl-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .bl-hero {
      padding: 150px 0 50px;
    }

    .bl-body {
      padding: 40px 0 70px;
    }

    .bl-grid {
      grid-template-columns: 1fr;
    }
  }
</style>