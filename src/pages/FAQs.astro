---
import Layout from "../layouts/Layout.astro"; // must match your layout's real file name and folder

const faqGroups = [
  {
    id: "about",
    title: "About Uncore Digital",
    items: [
      {
        q: "What does Uncore Digital do?",
        a: "Uncore Digital is a digital agency that helps businesses grow online. We offer digital marketing, product design and development, digital transformation, and web and app development, from strategy through to launch and ongoing improvement.",
      },
      {
        q: "Where is Uncore Digital located?",
        a: "We have offices in Uniondale, New York (USA) and in India, and we work with clients remotely across time zones.",
      },
      {
        q: "Which industries do you work with?",
        a: "We work with growth-focused businesses across industries, including manufacturing, finance and professional services. If your industry is not listed, get in touch and we will tell you honestly whether we are the right fit.",
      },
      {
        q: "Who will I be working with?",
        a: "You work directly with our leadership and a dedicated delivery team. You get a clear point of contact, regular updates, and no hand-offs to people who do not know your project.",
      },
    ],
  },
  {
    id: "services",
    title: "Our Services",
    items: [
      {
        q: "What digital marketing services do you offer?",
        a: "We build performance-driven marketing strategies to help brands reach, engage and grow. This includes content that connects and campaigns designed to convert, with reporting so you can see what is working.",
      },
      {
        q: "Do you build websites and mobile apps?",
        a: "Yes. We design and develop fast, intuitive web and mobile products that are built to scale, including MVPs, web apps and platforms. We act as an extended tech team for your business.",
      },
      {
        q: "What is digital transformation?",
        a: "Digital transformation means using better tools and smarter workflows to run your business more efficiently. We automate, optimise and modernise digital systems, such as CRM setups, workflow automation and internal platforms.",
      },
      {
        q: "Can you help if I already have a website or product?",
        a: "Yes. We can audit what you have, then improve its design, speed, search visibility or functionality. You do not need to start from scratch.",
      },
      {
        q: "Can I hire you for just one service?",
        a: "Yes. You can engage us for a single project, such as a website or a marketing campaign, or combine services as your needs grow.",
      },
    ],
  },
  {
    id: "working-with-us",
    title: "Working With Us",
    items: [
      {
        q: "How do I get started?",
        a: "Book a free consultation through our contact form or email us. We will talk through your goals, challenges and budget, then recommend the best approach and next steps.",
      },
      {
        q: "What does your process look like?",
        a: "We start with discovery to understand your goals, then move to strategy and planning, design and development, testing and launch. After launch we support and improve based on real results. You will see progress at each stage.",
      },
      {
        q: "How much do your services cost?",
        a: "Pricing depends on the scope, complexity and timeline of your project, so we do not use one-size-fits-all packages. After a short discovery call we provide a clear, written proposal with costs before any work starts.",
      },
      {
        q: "How long does a project take?",
        a: "Timelines depend on the project. A focused marketing campaign can start quickly, while a custom web or mobile product takes longer. We give you a realistic timeline in the proposal and keep you updated if anything changes.",
      },
      {
        q: "Do you work with clients outside India and the USA?",
        a: "Yes. We work with clients remotely and communicate through email, video calls and project tools that suit your schedule.",
      },
    ],
  },
  {
    id: "support",
    title: "Support, Ownership & Privacy",
    items: [
      {
        q: "Do you offer support after the project launches?",
        a: "Yes. We offer ongoing support, maintenance and optimisation so your website, product or campaigns keep performing after launch. The details are agreed with you up front.",
      },
      {
        q: "Who owns the work you create?",
        a: "Ownership of deliverables, such as designs and code, is set out in the agreement we sign with you before the project begins, so there are no surprises.",
      },
      {
        q: "How do you handle my data and privacy?",
        a: "We only collect the information we need to respond to you and deliver our services, and we do not sell personal information. You can read the details in our Privacy Policy at uncoredigital.com/privacy-policy.",
      },
      {
        q: "How can I contact Uncore Digital?",
        a: "You can email us at connect@uncoredigital.com, call +91 97255 18964, or use the contact form on our website. We aim to respond to enquiries promptly.",
      },
    ],
  },
];

// Structured data built from the same list, so it always matches the visible text
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqGroups.flatMap((group) =>
    group.items.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  ),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://uncoredigital.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "FAQs",
      item: "https://uncoredigital.com/faq",
    },
  ],
};
---

<Layout
  title="FAQs | Uncore Digital – Digital Marketing, Web & Product Development"
  description="Answers to common questions about Uncore Digital: our services, how we work, pricing, timelines, support, and how to get started with a free consultation."
>
  <!-- Canonical + social tags, placed in <head> through your existing custom-css slot -->
  <Fragment slot="custom-css">
    <link rel="canonical" href="https://uncoredigital.com/faq" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="FAQs | Uncore Digital" />
    <meta
      property="og:description"
      content="Answers to common questions about Uncore Digital's services, process, pricing and support."
    />
    <meta property="og:url" content="https://uncoredigital.com/faq" />
  </Fragment>

  <!-- SEO structured data (invisible to visitors, read by search engines) -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <!-- FAQ Hero Start -->
  <section class="faq-hero">
    <div class="container">
      <span class="faq-hero__eyebrow poppins-bold">Support</span>
      <h1 class="faq-hero__title poppins-bold">Frequently Asked Questions</h1>
      <p class="faq-hero__text montserrat-regular">
        Everything you need to know about working with Uncore Digital. Can't
        find your answer? We're happy to help.
      </p>
      <nav class="faq-chips" aria-label="FAQ categories">
        {
          faqGroups.map((group) => (
            <a href={`#${group.id}`} class="faq-chip montserrat-semibold">
              {group.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>
  <!-- FAQ Hero End -->

  <!-- FAQ Start -->
  <section class="faq-body">
    <div class="container">
      <div class="faq-wrap">
        {
          faqGroups.map((group) => (
            <section id={group.id} class="faq-group">
              <h2 class="faq-group__title poppins-bold">{group.title}</h2>
              {group.items.map((item) => (
                <details class="faq-item">
                  <summary class="faq-item__q poppins-bold">
                    <span>{item.q}</span>
                    <i class="faq-item__icon" aria-hidden="true" />
                  </summary>
                  <div class="faq-item__a montserrat-regular">
                    <p>{item.a}</p>
                  </div>
                </details>
              ))}
            </section>
          ))
        }

        <!-- CTA -->
        <div class="faq-cta">
          <h2 class="faq-cta__title poppins-bold">Still have a question?</h2>
          <p class="faq-cta__text montserrat-regular">
            Talk to our team and get a free consultation. We reply to every
            enquiry.
          </p>
          <div class="tz-buttons d-flex justify-content-center">
            <a
              class="tz-button text-uppercase fw-medium tz-text-m montserrat-regular"
              href="/contact-us"
            >
              Contact Us</a
            >
            <a class="tz-button-circle" href="/contact-us"
              ><i class="ph ph-arrow-up-right"></i></a
            >
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- FAQ End -->
</Layout>

<style>
  /* Hero */
  .faq-hero {
    background: #121212;
    padding: 190px 0 70px; /* top padding clears the fixed header */
    text-align: center;
  }

  .faq-hero__eyebrow {
    display: inline-block;
    color: #caf310;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 14px;
    margin-bottom: 14px;
  }

  .faq-hero__title {
    color: #fff;
    font-size: clamp(34px, 5.5vw, 60px);
    line-height: 1.1;
    margin: 0 0 16px;
  }

  .faq-hero__text {
    color: #b5b5b5;
    font-size: 17px;
    max-width: 620px;
    margin: 0 auto 28px;
  }

  .faq-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .faq-chip {
    padding: 9px 16px;
    border: 1px solid #3a3a3a;
    border-radius: 999px;
    color: #e5e5e5;
    font-size: 14px;
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .faq-chip:hover {
    background: #caf310;
    border-color: #caf310;
    color: #000;
  }

  /* Body */
  .faq-body {
    background: #fff;
    padding: 70px 0 100px;
  }

  .faq-wrap {
    max-width: 860px;
    margin: 0 auto;
  }

  .faq-group {
    margin-bottom: 52px;
    scroll-margin-top: 130px;
  }

  .faq-group__title {
    color: #000;
    font-size: 26px;
    margin: 0 0 18px;
    padding-left: 14px;
    border-left: 4px solid #caf310;
  }

  /* Accordion (native <details>, works without JavaScript) */
  .faq-item {
    background: #fff;
    border: 1px solid #e4e8ee;
    border-radius: 12px;
    margin-bottom: 12px;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .faq-item:hover {
    border-color: #caf310;
  }

  .faq-item[open] {
    border-color: #caf310;
    box-shadow: 0 8px 24px rgba(16, 24, 40, 0.08);
  }

  .faq-item__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    cursor: pointer;
    list-style: none;
    color: #101828;
    font-size: 17px;
    line-height: 1.4;
  }

  .faq-item__q::-webkit-details-marker {
    display: none;
  }

  .faq-item__q:focus-visible {
    outline: 3px solid #caf310;
    outline-offset: 2px;
    border-radius: 12px;
  }

  /* Plus / minus icon */
  .faq-item__icon {
    position: relative;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #f1f3ee;
    transition: background-color 0.25s ease;
  }

  .faq-item__icon::before,
  .faq-item__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    background: #000;
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease;
  }

  .faq-item__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-item[open] .faq-item__icon {
    background: #caf310;
  }

  .faq-item[open] .faq-item__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq-item__a {
    padding: 0 22px 22px;
    color: #4a5565;
    font-size: 16px;
    line-height: 1.75;
  }

  .faq-item__a p {
    margin: 0;
    color: #4a5565;
  }

  /* CTA */
  .faq-cta {
    margin-top: 20px;
    padding: 44px 28px;
    text-align: center;
    background: #121212;
    border-radius: 16px;
  }

  .faq-cta__title {
    color: #fff;
    font-size: 28px;
    margin: 0 0 10px;
  }

  .faq-cta__text {
    color: #b5b5b5;
    max-width: 460px;
    margin: 0 auto 24px;
  }

  @media (max-width: 767px) {
    .faq-hero {
      padding: 150px 0 50px;
    }

    .faq-item__q {
      font-size: 16px;
      padding: 18px;
    }

    .faq-item__a {
      padding: 0 18px 18px;
    }

    .faq-group__title {
      font-size: 22px;
    }
  }
</style>