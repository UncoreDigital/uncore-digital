---
import Analytics from "@vercel/analytics/astro";
import OffCanvas from "../components/OffCanvas.astro";
// use for pages other than Home page
import Header2 from "../components/Header2.astro";
import Footer from "../components/Footer.astro";
import Chatbot from "../components/Chatbot.astro";

const {
  title = "Uncore Digital",
  description = "Uncore Digital is a digital agency offering digital marketing, product development, digital transformation, and web and app development.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Phosphor Icon css -->
    <link rel="stylesheet" href="/assets/css/phosphoricons.css" />
    <!-- animate css -->
    <link rel="stylesheet" href="/assets/css/animate.css" />
    <!-- Magnific Popup css -->
    <link rel="stylesheet" href="/assets/css/magnific-popup.min.css" />
    <!-- bootstrap css -->
    <link rel="stylesheet" href="/assets/css/bootstrap.min.css" />
    <!-- Swiper css -->
    <link rel="stylesheet" href="/assets/css/swiper-bundle.min.css" />
    <!-- style css -->
    <link rel="stylesheet" href="/assets/css/styles.css" />

    <link rel="stylesheet" href="/assets/css/fonts.css" />
    <link rel="stylesheet" href="/assets/css/logo.css" />
    <slot name="custom-css" />
  </head>
  <body class="tz-bg-neutral3">
    <div class="tz-body-overlay"></div>

    <!-- Preloader -->
    <div class="preloader">
      <div class="spinner-wrap">
        <div class="preloader-logo">
          <img
            src="/assets/images/loader/uncore loader.gif"
            alt=""
            class="img-fluid"
          />
        </div>
      </div>
    </div>
    <!-- Preloader End -->

    <!-- back to top button -->
    <a href="#" id="scroll-top" class="back-to-top-btn"
      ><i class="ph ph-arrow-up"></i></a
    >

    <OffCanvas />
    <Header2 />
    <slot />
    <Chatbot />
    <Footer />

    <!-- jQuery (loaded once) -->
    <script is:inline src="/assets/js/jquery-3.7.1.min.js"></script>
    <!-- bootstrap -->
    <script is:inline src="/assets/js/bootstrap.bundle.min.js"></script>
    <!-- Swiper -->
    <script is:inline src="/assets/js/swiper-bundle.min.js"></script>
    <!-- FlatPickr -->
    <script is:inline src="/assets/js/flatpickr.js"></script>
    <!-- Magnific Popup -->
    <script is:inline src="/assets/js/magnific-popup.min.js"></script>
    <!-- Counter up -->
    <script is:inline src="/assets/js/counterup.min.js"></script>
    <!-- Wow -->
    <script is:inline src="/assets/js/wow.min.js"></script>
    <!-- main js (loaded once) -->
    <script is:inline src="/assets/js/main.js"></script>

    <Analytics />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Outfit";
    src: url("/assets/fonts/outfit/OutfitRegular.ttf") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Teko";
    src: url("/assets/fonts/teko/Teko-Bold.ttf") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Teko Regular";
    src: url("/assets/fonts/teko/Teko-Regular.ttf") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>